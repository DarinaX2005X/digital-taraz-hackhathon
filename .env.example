# Local startup supplies a loopback PostgreSQL URL when DATABASE_URL is omitted.
# Configure actual managed service credentials separately for deployment.
DATABASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2.5
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=10259
SMTP_FROM=Tirlik <noreply@localhost>
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false
# Deployment only: use smtp-relay.brevo.com:587 and SMTP_REQUIRE_TLS=true.
# SMTP_PASSWORD is a Brevo SMTP key, never a Brevo API key.
# SMTP_FROM must be a verified sender address in your Brevo account.
