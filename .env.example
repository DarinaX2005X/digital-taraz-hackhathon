# Local startup supplies a loopback PostgreSQL URL when DATABASE_URL is omitted.
# Configure actual managed service credentials separately for deployment.
DATABASE_URL=
# Local/self-hosted deployments use persistent files even when R2 credentials are present.
# Vercel must set TIRLIK_STORAGE_DRIVER=r2; it never falls back to ephemeral files.
TIRLIK_STORAGE_DRIVER=local
TIRLIK_DATA_DIR=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
# Defaults to 10 when omitted. Set the deployment's explicit share of one authorized total before activation.
TIRLIK_MODEL_AUTHORIZATION_LIMIT_USD=10
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=10259
SMTP_FROM=Tirlik <noreply@localhost>
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false
# Deployment only: use smtp-relay.brevo.com:587 and SMTP_REQUIRE_TLS=true.
# SMTP_PASSWORD is a Brevo SMTP key, never a Brevo API key.
# SMTP_FROM must be a verified sender address in your Brevo account.
