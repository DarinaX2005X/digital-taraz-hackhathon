{
  "name": "tirlik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "db:seed": "tsx src/server/db/seed-cli.ts",
    "fixtures:generate": "node scripts/fixtures/generate.mjs",
    "fixtures:verify": "node scripts/fixtures/verify.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@ariakit/react": "0.4.41",
    "@opentelemetry/api": "1.9.0",
    "@univerjs/core": "1.0.4",
    "@univerjs/docs": "1.0.4",
    "@univerjs/engine-formula": "1.0.4",
    "@univerjs/engine-render": "1.0.4",
    "@univerjs/sheets": "1.0.4",
    "@univerjs/sheets-formula": "1.0.4",
    "@univerjs/sheets-numfmt": "1.0.4",
    "@vercel/blob": "2.8.1",
    "arima": "0.2.8",
    "better-auth": "1.7.7",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "docx": "9.10.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fabric": "7.4.0",
    "jszip": "3.10.2",
    "lucide-react": "0.468.0",
    "mammoth": "1.13.0",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "simple-statistics": "7.12.1",
    "workflow": "5.2.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@workflow/core": {
      "devalue": "5.9.4",
      "nanoid": "5.1.16"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
